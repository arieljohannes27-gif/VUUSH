{
  "name": "SWIFT Design System",
  "version": "1.0.0",
  "color": {
    "white": "#FFFFFF",
    "bg": "#FAFAFA",
    "surface": "#F5F6F8",
    "border": "#E7EAF0",
    "text": "#1C1F26",
    "textMuted": "#6B7280",
    "blue": "#2563EB",
    "blueSoft": "#EFF4FF",
