# Copy to .env — never commit .env (see .gitignore)
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Local Docker Compose defaults (docker compose up -d postgres)
DATABASE_URL=postgres://swift:swift@localhost:55432/swift_platform

# Comma-separated HTTPS origins. Required in staging/production (never leave empty there).
# Example prod: https://vuush-dispatch.vercel.app,https://vuush-enterprise.vercel.app
CORS_ORIGINS=

# Auth (change AUTH_PEPPER before any real deploy)
AUTH_PEPPER=dev-only-change-me-auth-pepper
OTP_TTL_SECONDS=300
ACCESS_TTL_SECONDS=3600
REFRESH_TTL_SECONDS=2592000
MFA_TICKET_TTL_SECONDS=300

# OTP email — console is local only; production must use resend
OTP_EMAIL_PROVIDER=console
# RESEND_API_KEY=re_...
# OTP_EMAIL_FROM=VUUSH <noreply@yourdomain.com>

# Payments (M8 / Harden H1) — local default is stub; never put card PANs here
PSP_PROVIDER=dev_stub
PSP_WEBHOOK_SECRET=dev-webhook-secret
# When PSP_PROVIDER=paystack (sandbox):
# PAYSTACK_SECRET_KEY=sk_test_...
# PAYSTACK_PUBLIC_KEY=pk_test_...
# PAYSTACK_CALLBACK_URL=http://localhost:5175/pay/callback
# PAYSTACK_LIVE_ENABLED=false
# PAYSTACK_DEFAULT_TRANSFER_RECIPIENT=RCP_...
# Webhook URL: POST /v1/payments/webhooks/paystack

# Tracking (M5)
TRACK_FRESH_SECONDS=45
TRACK_STALE_SECONDS=90
TRACK_LOST_SECONDS=180
TRACK_TELEPORT_KM=8
TRACK_MAX_SPEED_MPS=55

# Proof geofence (M6a) — metres from dropoff to allow complete delivery
PROOF_DROPOFF_RADIUS_M=150
